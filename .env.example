# Copy to .env and fill in. Names only here: never commit real values.
# Generate PAN_ENCRYPTION_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate JWT_SECRET with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=dev
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ngo
JWT_SECRET=
PAN_ENCRYPTION_KEY=
# Shared secret the (mock) payment gateway signs webhooks with; 32+ chars
GATEWAY_WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:3000

# Receipt and 80G certificate details (placeholders in the demo)
TRUST_NAME=
TRUST_PAN=
TRUST_80G_REG=

# Optional: password for the seeded demo accounts (see deployment.md)
SEED_DEMO_PASSWORD=

# Frontend (server-side URL of the API; the browser uses the /api proxy)
API_URL=http://localhost:8000
GATEWAY_WEBHOOK_SECRET=   # frontend server only: signs the test-mode payment simulation (same value as the API)

# Optional: enables AI Hindi summary drafting (Anthropic API); SUMMARY_MODEL defaults to claude-haiku-5-5
ANTHROPIC_API_KEY=
