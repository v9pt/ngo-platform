# Copy to .env and fill in. Names only here: never commit real values.
# Generate PAN_ENCRYPTION_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate JWT_SECRET and GATEWAY_WEBHOOK_SECRET with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- API ---
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/ngo
JWT_SECRET=
PAN_ENCRYPTION_KEY=
GATEWAY_WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:3000
# test turns on the card simulator and monthly run button; live turns both off
GATEWAY_MODE=test
# Receipt details. Placeholders are used when these are empty.
TRUST_NAME=
TRUST_PAN=
TRUST_80G_REG=
# Optional: password for the seeded demo accounts
SEED_DEMO_PASSWORD=
# Optional: turns on Claude. Without it, summaries are written by hand and the finder's typed
# question uses its keyword reader.
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-opus-5-5
# Behind a proxy, set to the proxy's address so rate limits see each visitor's own IP.
FORWARDED_ALLOW_IPS=

# --- Frontend ---
# Server-side URL of the API. The browser only ever uses the /api proxy. Read at build time too.
API_URL=http://localhost:8000
# Set to false to hide the demo accounts panel on the login page.
SHOW_DEMO_LOGINS=true
